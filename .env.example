# AI 图片生成器 - 环境变量配置

# 默认 Provider: aihubmix | huggingface | pollinations
# aihubmix 统一接入（推荐，支持支付宝）；huggingface 完全免费；pollinations 免费备用
# 留空则使用代码内置默认（aihubmix）
# PROVIDER=aihubmix

# ===== AIHubMix（统一接入·推荐·支持支付宝）=====
# 获取地址: https://aihubmix.com/token （注册后支付宝/微信充值，控制台创建 Key）
AIHUBMIX_KEY=

# ===== Hugging Face（完全免费推理）=====
# 获取地址: https://huggingface.co/settings/tokens （免费注册，建一个 read 权限 token 即可）
# 提供 4 个公开 SDXL/SD 模型，无需充值
HUGGINGFACE_KEY=

# ===== Pollinations =====
# 服务端（Node）调用 Pollinations 现在需要 Bearer Token 解锁额度。
# 免费获取：访问 https://auth.pollinations.ai 登录后创建 token，
# 或浏览器打开 https://image.pollinations.ai 后在控制台 Network 里看 Authorization 头。
# 留空则走匿名额度（可能被限流/报 PAYMENT_REQUIRED）。
POLLINATIONS_TOKEN=

# ===== 以下为隐藏引擎（按需启用，恢复方法见 config.js 中 hidden: true 字段）=====
# SILICONFLOW_KEY=
# FAL_KEY=

# ===== Showcase / Cloudflare D1（作品墙 · 可选）=====
# 在 https://dash.cloudflare.com → Workers & Pages → D1 创建数据库
# 在 My Profile → API Tokens 创建 token（权限 D1:Edit）
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# ===== Cloudflare R2（图片文件存储 · 可选）=====
# 在 https://dash.cloudflare.com → R2 创建 bucket
# 在 R2 → Manage API Tokens 创建 token（Object Read & Write）
# 在 Bucket → Public Development URL 启用公开访问
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# 服务端口
PORT=3000
